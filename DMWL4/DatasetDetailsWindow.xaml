<Window x:Class="MWL4.DatasetDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MWL4.ViewModels"
        Title="Dataset details"
        Height="600"
        Width="750"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Close" Width="80" Height="25" DockPanel.Dock="Right" IsCancel="True" Click="CloseButton_Click"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Expand all" Width="90" Height="25" Margin="0,0,8,0" Click="ExpandAllButton_Click"/>
                <Button Content="Collapse all" Width="90" Height="25" Margin="0,0,8,0" Click="CollapseAllButton_Click"/>
                <Button Content="Copy as text" Width="90" Height="25" Click="CopyButton_Click"/>
            </StackPanel>
        </DockPanel>

        <TreeView x:Name="DatasetTree" FontFamily="Consolas" FontSize="12"
                  VirtualizingStackPanel.IsVirtualizing="False">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:DatasetNode}" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Text}"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
