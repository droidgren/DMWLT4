<Window x:Class="MWL4.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About"
        Width="518"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="15">
        <TextBlock Text="DICOM Modality Worklist Tester" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="A tool to test or simulate Dicom Worklist as a SCU" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Version}" d:Text="Version 1.0.0.0" Margin="0,5,0,0" HorizontalAlignment="Center"/>
        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center">
            <Run Text="{Binding UpdateStatus, Mode=OneWay}"/>
            <Hyperlink NavigateUri="{Binding ReleaseUri, Mode=OneWay}" RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="{Binding ReleaseLinkText, Mode=OneWay}"/>
            </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center">
            <Hyperlink NavigateUri="https://github.com/droidgren/DMWLT4" RequestNavigate="Hyperlink_RequestNavigate">
                https://github.com/droidgren/DMWLT4
            </Hyperlink>
        </TextBlock>

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/VGR.png" Width="162" Height="47" Opacity="0.75" HorizontalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Company}" d:Text="Vastra Gotalandsregionen" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Copyright}" d:Text="Copyright Anders Dahlgren 2026" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Button Content="OK" Width="75" Height="23" HorizontalAlignment="Center" Click="Ok_Click" IsDefault="True" IsCancel="True" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
